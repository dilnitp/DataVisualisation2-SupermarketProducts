{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Tile-grid cartogram: share of adults who did not eat the recommended daily vegetables, by state and territory, adjusted for age. Each state is the same size. Source: ABS National Health Survey 2022.",
  "title": {
    "text": "About 9 in 10 adults miss the daily vegetable target",
    "subtitle": "Share of adults not eating enough vegetables, 2022 (adjusted for age). One tile per state."
  },
  "data": {
    "url": "data/nhs_states.csv",
    "format": {
      "type": "csv",
      "parse": {
        "veg_not_met_age_adj": "number",
        "tile_x": "number",
        "tile_y": "number"
      }
    }
  },
  "width": 380,
  "height": 380,
  "transform": [
    {
      "filter": "isValid(datum.tile_x)"
    },
    {
      "calculate": "[datum.abbr, round(datum.veg_not_met_age_adj) + '%']",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.04
          }
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.04
          }
        },
        "color": {
          "field": "veg_not_met_age_adj",
          "type": "quantitative",
          "scale": {
            "domain": [
              89,
              95.5
            ],
            "range": [
              "#e8f5e9",
              "#2e7d32"
            ]
          },
          "legend": {
            "title": "Not enough veg (%)",
            "titleLimit": 220,
            "orient": "right",
            "gradientLength": 160,
            "format": "d",
            "values": [
              90,
              92,
              94
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "veg_not_met_age_adj",
            "title": "Not enough vegetables (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 700,
        "lineBreak": null
      },
      "encoding": {
        "x": {
          "field": "tile_x",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "tile_y",
          "type": "ordinal",
          "axis": null
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.veg_not_met_age_adj > 92.5",
            "value": "#ffffff"
          },
          "value": "#1f2937"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Queensland is highest:"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#166534"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "value": 205
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "95% miss the target"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#166534"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "value": 222
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Tasmania is lowest:"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#166534"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "value": 252
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "90% miss the target"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#166534"
      },
      "encoding": {
        "x": {
          "value": 4
        },
        "y": {
          "value": 269
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "'DM Sans', system-ui, sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 260,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#4b5563",
      "titleColor": "#1f2937",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "gridColor": "#e5e7eb",
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4b5563",
      "titleColor": "#1f2937"
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#1f2937",
      "subtitleColor": "#4b5563",
      "subtitleFontSize": 13,
      "subtitlePadding": 6,
      "offset": 14
    },
    "header": {
      "labelFontSize": 12,
      "labelColor": "#1f2937"
    }
  }
}