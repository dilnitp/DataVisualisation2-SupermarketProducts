{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Connection map: countries where products listed in Australia are also listed as sold. Line width and circle size show the number of products. Source: Open Food Facts.",
  "title": {
    "text": "Many products sell overseas too",
    "subtitle": "Products listed in Australia and in another country"
  },
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/world.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name == 'Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#fdba74",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/shared_countries.csv",
        "format": {
          "type": "csv",
          "parse": {
            "products": "number",
            "lat": "number",
            "lon": "number",
            "label_lon": "number",
            "label_lat": "number",
            "aus_lat": "number",
            "aus_lon": "number"
          }
        }
      },
      "mark": {
        "type": "rule",
        "color": "#c2410c",
        "opacity": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "aus_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "aus_lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon"
        },
        "latitude2": {
          "field": "lat"
        },
        "strokeWidth": {
          "field": "products",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              2300
            ],
            "range": [
              1,
              9
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/shared_countries.csv",
        "format": {
          "type": "csv",
          "parse": {
            "products": "number",
            "lat": "number",
            "lon": "number",
            "label_lon": "number",
            "label_lat": "number",
            "aus_lat": "number",
            "aus_lon": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "color": "#c2410c",
        "opacity": 0.95,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "products",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              2300
            ],
            "range": [
              40,
              900
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "products",
            "title": "Shared products",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/shared_countries.csv",
        "format": {
          "type": "csv",
          "parse": {
            "products": "number",
            "lat": "number",
            "lon": "number",
            "label_lon": "number",
            "label_lat": "number",
            "aus_lat": "number",
            "aus_lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.country == 'New Zealand'"
        },
        {
          "calculate": "datum.country + ' ' + format(datum.products, ',')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Europe"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#c2410c"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 70
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "France 1,806"
          }
        ]
