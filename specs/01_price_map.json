{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Symbol map: change in food prices over 12 months to August 2026, by capital city (ABS CPI).",
  "title": {
    "text": "Food prices rose in every capital city",
    "subtitle": "Change in food and drink prices, 12 months to August 2026"
  },
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 40,
    "right": 10,
    "top": 5,
    "bottom": 5
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "data": {
    "url": "data/cpi_food_cities.csv"
  },
  "layer": [
    {
      "data": {
        "url": "data/states.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 0.92,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "change_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              2,
              4
            ],
            "range": [
              350,
              1700
            ]
          },
          "legend": {
            "title": "Price rise (%)",
            "orient": "top-right",
            "direction": "vertical",
            "format": ".1f",
            "values": [
              2.5,
              3.0,
              3.5
            ]
          }
        },
        "color": {
          "field": "change_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              2,
              4
            ],
            "range": [
              "#fef08a",
              "#713f12"
            ]
          },
          "legend": {
            "title": "Price rise (%)",
            "orient": "top-right",
            "direction": "vertical",
            "format": ".1f",
            "values": [
              2.5,
              3.0,
              3.5
            ]
          }
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "change_pct",
            "title": "Price rise (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.align == 'left'"
        },
        {
          "calculate": "datum.city + ' ' + format(datum.change_pct, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.align == 'right'"
        },
        {
          "calculate": "datum.city + ' ' + format(datum.change_pct, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.align == 'center'"
        },
        {
          "calculate": "datum.city + ' ' + format(datum.change_pct, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Biggest rise: Hobart, 3.6%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#c2410c"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 318
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Smallest rise: Canberra, 2.4%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#c2410c"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 338
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "'DM Sans', system-ui, sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 260,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelColor": "#4b5563",
      "titleColor": "#1f2937",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "gridColor": "#e5e7eb",
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#4b5563",
      "titleColor": "#1f2937"
    },
    "title": {
      "fontSize": 16,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#1f2937",
      "subtitleColor": "#4b5563",
      "subtitleFontSize": 13,
      "subtitlePadding": 6,
      "offset": 14
    },
    "header": {
      "labelFontSize": 12,
      "labelColor": "#1f2937"
    }
  }
}